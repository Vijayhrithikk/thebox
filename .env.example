# ─── Telephony ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# ─── Speech to text (Telugu / Hindi / English, auto language ID) ──────────────
SONIOX_API_KEY=

# ─── Text to speech (Indian languages, Tenglish code-switching) ──────────────
SARVAM_API_KEY=
SARVAM_VOICE=anushka
SARVAM_MODEL=bulbul:v3

# ─── The brain ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# In-call: fast mode, low effort. Post-call: high effort, no fast mode.
LLM_MODEL=claude-opus-5

# ─── Storage ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://...

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# 'web-session' = your own number via a paired session (fast, free-form)
# 'cloud-api'   = Meta Cloud API templates (production path)
WHATSAPP_DRIVER=web-session
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── Identity (appears in the script and every message) ──────────────────────
CANDIDATE_NAME=
CANDIDATE_PHONE=+91...
RESUME_PATH=./assets/resume.pdf
ARCHITECTURE_IMAGE_PATH=./assets/architecture.png

# ─── Targets ──────────────────────────────────────────────────────────────────
# The recruiter. Do NOT point rehearsals at this.
PROSPECT_PHONE=+918688664337
# Your own second number, for every rehearsal.
TEST_PHONE=+91...

# ─── Runtime ──────────────────────────────────────────────────────────────────
PORT=8080
PUBLIC_HOST=
LOG_LEVEL=info
