# ─── Telephony ────────────────────────────────────────────────────────────────
# 'exotel' = current default. Indian domestic provider — calling India is a
#            same-country call, so it sidesteps the cross-border verification
#            wall both Twilio and Telnyx hit. No card needed for the trial.
#            Needs an App Bazaar flow (Voicebot Applet) built once in the
#            portal — see docs/SETUP.md.
# 'telnyx' = no forced minimum deposit, but gates calling India behind an
#            account-verification tier. Kept as a documented fallback.
# 'twilio' = fully built, proven end to end up to the trial account's <Stream>
#            wall — needs the $20 upgrade to go further. Kept as a documented
#            fallback; switching back is this one line, zero code changes.
TELEPHONY_PROVIDER=exotel

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Domestic format, not E.164 (e.g. "08047280713")
EXOTEL_EXOPHONE=
# App Bazaar flow ID holding the Voicebot Applet
EXOTEL_APP_ID=

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+1...
# The Call Control Application's ID (Telnyx calls this "connection_id" on the wire)
TELNYX_CONNECTION_ID=

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# ─── Speech to text (Telugu / Hindi / English, auto language ID) ──────────────
SONIOX_API_KEY=

# ─── Text to speech (Indian languages, Tenglish code-switching) ──────────────
SARVAM_API_KEY=
SARVAM_VOICE=priya
SARVAM_MODEL=bulbul:v3

# ─── The brain ────────────────────────────────────────────────────────────────
# 'anthropic' = Claude Opus 5, fast mode + adaptive thinking at low effort.
# 'deepseek'  = DeepSeek V4 Pro, reasoning_effort forced to "low" for live calls —
#               at "high"/"max" it's independently benchmarked at 12-30s to first
#               token, which would kill the call. Only ANTHROPIC_API_KEY or
#               DEEPSEEK_API_KEY is required, matching whichever you pick.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

DEEPSEEK_API_KEY=
# deepseek-chat / deepseek-reasoner retired 2026-07-24 — this is the current flagship.
DEEPSEEK_MODEL=deepseek-v4-pro

# ─── Storage ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://...

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# 'web-session' = your own number via a paired session (fast, free-form)
# 'cloud-api'   = Meta Cloud API templates (production path)
WHATSAPP_DRIVER=web-session
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── Identity (appears in the script and every message) ──────────────────────
CANDIDATE_NAME=
CANDIDATE_PHONE=+91...
RESUME_PATH=./assets/resume.pdf
ARCHITECTURE_IMAGE_PATH=./assets/architecture.png

# ─── Targets ──────────────────────────────────────────────────────────────────
# The recruiter. Do NOT point rehearsals at this.
PROSPECT_PHONE=+918688664337
# Your own second number, for every rehearsal.
TEST_PHONE=+91...

# ─── Runtime ──────────────────────────────────────────────────────────────────
PORT=8080
PUBLIC_HOST=
LOG_LEVEL=info
